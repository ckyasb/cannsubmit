# Created: 2026-11-12. Author: ckyasb.
# Purpose: Document the local environment variable used for submission authentication.
# Added: A placeholder path only; no Cookie, token or session value belongs here.
# Copy this file to .env and edit the path before sourcing it in your shell.
# The CLI does not automatically load .env files. Anonymous score queries need no session.
CANNJUDGE_COOKIE_FILE=/absolute/path/outside/repository/cannjudge-cookie.txt
